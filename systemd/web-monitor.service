[Unit]
Description=Web Page Update Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/auto-web-monitoring-cli
EnvironmentFile=/opt/auto-web-monitoring-cli/.env
ExecStart=/opt/auto-web-monitoring-cli/.venv/bin/python /opt/auto-web-monitoring-cli/monitor.py --config /opt/auto-web-monitoring-cli/monitoring.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
